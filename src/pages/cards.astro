---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCards } from '../lib/data';
import { uniqueValues } from '../lib/search';
import CardItem from '../components/CardItem.astro';
import FilterPanel from '../components/FilterPanel.astro';

const cards = getCards();
const issuers = uniqueValues(cards, (card) => card.issuer);
---

<BaseLayout title="全部信用卡">
  <section class="shell py-10" data-list-target="cards">
    <div class="mb-8 max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.22em] text-blue-700">信用卡库</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 md:text-5xl">全部信用卡</h1>
      <p class="mt-4 text-lg leading-8 text-slate-600">按地区、银行、评分、年费和开卡奖励筛选排序。</p>
    </div>
    <FilterPanel target="cards" issuers={issuers} />
    <div class="mt-5 grid gap-4 lg:grid-cols-2">
      {cards.map((card) => <CardItem card={card} />)}
    </div>
  </section>
</BaseLayout>
