---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDateTime, formatRegion, formatReliability, formatSourceStatus } from '../lib/format';
import { getMetadata, getSources } from '../lib/data';

const metadata = getMetadata();
const configuredSources = getSources();
const statuses = new Map(metadata.sources.map((source) => [source.id, source]));
---

<BaseLayout title="数据来源">
  <section class="shell py-10">
    <div class="mb-8 max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.22em] text-blue-700">数据来源</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 md:text-5xl">抓取来源与运行状态</h1>
      <p class="mt-4 text-lg leading-8 text-slate-600">每个来源都记录公开 URL、可靠性、最后检查时间、成功/失败状态和产出数量。</p>
    </div>

    <div class="panel overflow-hidden">
      <div class="grid grid-cols-1 border-b border-slate-200 bg-slate-100/80 p-4 text-xs font-bold uppercase tracking-wide text-slate-500 md:grid-cols-[1.3fr_0.7fr_0.7fr_0.7fr_0.7fr]">
        <span>来源</span><span>地区</span><span>状态</span><span>数量</span><span>最后检查</span>
      </div>
      {configuredSources.map((source) => {
        const status = statuses.get(source.id);
        return (
          <div class="grid gap-2 border-b border-slate-200 p-4 text-sm last:border-b-0 md:grid-cols-[1.3fr_0.7fr_0.7fr_0.7fr_0.7fr] md:items-center">
            <div>
              <a class="font-bold text-slate-950 hover:text-blue-700" href={source.url} target="_blank" rel="noreferrer">{source.name}</a>
              <p class="mt-1 text-xs text-slate-500">{source.id} · {formatReliability(source.reliability)}</p>
              {status?.error && <p class="mt-2 text-xs text-red-700">{status.error}</p>}
            </div>
            <span>{formatRegion(source.region)}</span>
            <span class={status?.status === 'success' ? 'font-semibold text-emerald-700' : 'font-semibold text-red-700'}>{formatSourceStatus(status?.status)}</span>
            <span>{status?.itemCount ?? 0}</span>
            <span>{formatDateTime(status?.lastCheckedAt)}</span>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>
